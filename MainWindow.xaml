<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="K8 Studio" Width="1180" Height="880" MinWidth="1080" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#0B0E15" Foreground="#EDF0F7" FontFamily="Segoe UI" FontSize="18" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
