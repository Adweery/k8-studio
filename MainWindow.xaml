       <Border Height="1" Background="#252D3C" Margin="0,11,0,12"/><Grid><TextBlock Text="Brightness" Foreground="#BAC3D4" FontSize="16"/><TextBlock x:Name="BrightnessValue" Text="100 %" HorizontalAlignment="Right" Foreground="#C4B5FD" FontSize="16"/></Grid><Slider x:Name="Brightness" Minimum="1" Maximum="15" Value="15" Margin="0,5,0,0"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" MinHeight="285"><StackPanel><Grid><TextBlock Text="Effect" FontSize="22" FontWeight="SemiBold"/></Grid><ComboBox x:Name="Effect" Margin="0,17,0,9"/><TextBlock x:Name="EffectDescription" Visibility="Collapsed" Text="One color. No animation." Foreground="#A5B0C5" FontSize="16" Height="19"/><Grid x:Name="SpeedRow" Margin="0,9,0,0"><TextBlock Text="Speed" FontSize="16" Foreground="#BAC3D4"/><TextBlock x:Name="SpeedValue" Text="9 / 16" Foreground="#C4B5FD" HorizontalAlignment="Right" FontSize="16"/></Grid><Slider x:Name="Speed" Minimum="0" Maximum="15" Value="8" Margin="0,3,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><CheckBox x:Name="Rainbow" Content="Multicolor" VerticalAlignment="Center" FontSize="16"/><ComboBox x:Name="Direction" Grid.Column="1" Height="38" FontSize="16"/></Grid><CheckBox x:Name="Live" Content="Auto apply" Margin="0,17,0,0" FontSize="16"/></StackPanel></Border>
     </Grid>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="Status" Text="" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="StatusDetail" Text="" FontSize="16" Foreground="#A5B0C5" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="White" Grid.Column="1" Content="White" Margin="0,0,10,0" VerticalAlignment="Center" Padding="16,13" FontSize="16"/><Button x:Name="Apply" Grid.Column="2" Style="{StaticResource Primary}" Content="Apply" VerticalAlignment="Center" Padding="19,13" FontSize="16"/></Grid>
   </Grid>
  </Grid>
 </Grid>
 </Border>
</Window>






